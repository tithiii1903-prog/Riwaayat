{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://riwaayat-mfvn.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://riwaayat-mfvn.onrender.com/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
